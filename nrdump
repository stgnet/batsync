"""


def main():
    args = sys.argv[1:]
    if args and args[0] in ('-h', '--help'):
        sys.stderr.write(__doc__)
        return 2
    if len(args) > 2:
        sys.stderr.write('usage: nrdump [flows.json] [output.html]\n')
        return 2
    src = args[0] if args else 'flows.json'
    dst = args[1] if len(args) > 1 else os.path.splitext(src)[0] + '.html'
    if os.path.abspath(dst) == os.path.abspath(src):
        dst = src + '.html'

    try:
        with open(src, encoding='utf-8') as f:
            data = json.load(f)
    except OSError as e:
        sys.stderr.write('ERROR: Cannot read %s: %s\n' % (src, e.strerror))
        return 1
    except ValueError as e:
        sys.stderr.write('ERROR: %s is not valid JSON: %s\n' % (src, e))
        return 1
    if isinstance(data, dict):
        data = data.get('flows')
    if not isinstance(data, list) or not all(isinstance(n, dict) and 'id' in n and 'type' in n for n in data):
        sys.stderr.write('ERROR: %s is not a Node-RED flows file\n' % src)
        return 1

    by_id = {n['id']: n for n in data}
    labels = {n['id']: node_label(n, by_id) for n in data}
    incoming = {}
    for n in data:
        for port in n.get('wires') or []:
            for tid in port:
                incoming.setdefault(tid, []).append(n['id'])

    containers = [n for n in data if n['type'] in ('tab', 'subflow')]
    container_ids = {n['id'] for n in containers}
    config = [n for n in data if n['type'] not in ('tab', 'subflow') and n.get('z') not in container_ids]

    body, nav = [], []
    for c in containers:
        members = [n for n in data if n.get('z') == c['id']]
        groups = [n for n in members if n['type'] == 'group']
        drawn = [n for n in members if n['type'] != 'group' and 'x' in n and 'y' in n]
        listed = sorted((n for n in members if n['type'] not in ('group', 'junction')),
                        key=lambda n: (round(n.get('y', 0) / 40.0), n.get('x', 0)))
        kind = 'Subflow' if c['type'] == 'subflow' else 'Flow'
        title = labels[c['id']]
        cid = anchor('n-', c['id'])
        nav.append('<a href="#%s">%s</a>' % (cid, esc(title)))
        body.append('<h2 id="%s">%s <span class="type">%s &middot; %d nodes%s</span></h2>' % (
            cid, esc(title), kind, len(listed), ' &middot; disabled' if c.get('disabled') else ''))
        if c.get('info'):
            body.append('<p class="info">%s</p>' % esc(str(c['info'])))
        body.append(render_diagram(drawn, groups, by_id, labels))
        drawn_ids = {n['id'] for n in drawn}
        body.append('<div class="nodes">%s</div>' % ''.join(
            render_node(n, by_id, labels, incoming, n['id'] in drawn_ids) for n in listed))
    if config:
        nav.append('<a href="#config">Configuration nodes</a>')
        body.append('<h2 id="config">Configuration nodes <span class="type">%d nodes</span></h2>' % len(config))
        body.append('<div class="nodes">%s</div>' % ''.join(
            render_node(n, by_id, labels, incoming, False) for n in config))

    name = os.path.basename(src)
    when = datetime.datetime.fromtimestamp(os.path.getmtime(src)).strftime('%Y-%m-%d %H:%M')
    summary = '%d flows, %d nodes, %d configuration nodes &middot; file dated %s' % (
        len(containers), len(data) - len(containers) - len(config), len(config), when)
    page = ('<!doctype html><html lang="en"><head><meta charset="utf-8">'
            '<meta name="viewport" content="width=device-width,initial-scale=1">'
            '<title>%s - Node-RED flows</title><style>%s</style></head><body>'
            '<header class="top"><strong>%s</strong><nav>%s</nav></header>'
            '<main><p class="summary">%s</p>%s</main></body></html>\n') % (
                esc(name), CSS, esc(name), ''.join(nav), summary, ''.join(body))

    try:
        with open(dst, 'w', encoding='utf-8') as f:
            f.write(page)
    except OSError as e:
        sys.stderr.write('ERROR: Cannot write %s: %s\n' % (dst, e.strerror))
        return 1
    print('Wrote %s (%d flows, %d nodes)' % (dst, len(containers), len(data) - len(containers)))
    return 0


if __name__ == '__main__':
    sys.exit(main())
